# Required: one OpenRouter key is used for text, images and embeddings.
OPENROUTER_API_KEY=sk-or-...

# Models (check ids on https://openrouter.ai/models)
GEN_MODEL=google/gemini-2.5-flash
# EXTRACT_MODEL is only asked for a country the field rules cannot read.
EXTRACT_MODEL=google/gemini-2.5-flash
AGENT_MODEL=openai/gpt-4.1-mini
IMAGE_MODEL=google/gemini-2.5-flash-image
EMBED_MODEL=openai/text-embedding-3-small

# Vector store: set CHROMA_HOST to use the Chroma server (docker-compose sets it).
# Leave empty to use an embedded store in data/chroma.
CHROMA_HOST=
CHROMA_PORT=8000
